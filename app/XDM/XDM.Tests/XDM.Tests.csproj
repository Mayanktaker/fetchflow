<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Match XDM.Core's TFM so shared sources compile cleanly -->
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <StartupObject>XDM.Tests.Program</StartupObject>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <!-- MSTest framework (uses [TestClass]/[TestMethod] + Microsoft.VisualStudio.TestTools.UnitTesting) -->
    <PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.1.1" />
    <!-- Newtonsoft.Json required by YDLOutputParser -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <!-- GtkSmokeTests: real Builder/Autoconnect smoke under Xvfb (DISPLAY). Same GtkSharp as XDM.Gtk.UI -->
    <PackageReference Include="GtkSharp" Version="3.24.24.38" />
    <!-- DownloadListMigrationTests: real SQLite round-trip for failure persistence -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.116" />
  </ItemGroup>

  <!-- Surgical include: only the YDLWrapper sources needed by YdlParserTests,
       avoiding the cost/fragility of importing the entire XDM.Core shared project -->
  <ItemGroup>
    <Compile Include="..\XDM.Core\YDLWrapper\YDLOutputParser.cs" Link="YDLWrapper\YDLOutputParser.cs" />
    <Compile Include="..\XDM.Core\YDLWrapper\Structs.cs" Link="YDLWrapper\Structs.cs" />
    <Compile Include="..\XDM.Core\IconResource.cs" Link="IconResource.cs" />
    <Compile Include="..\XDM.Core\RemixIcon.cs" Link="RemixIcon.cs" />
    <Compile Include="..\XDM.Core\UI\IconMap.cs" Link="UI\IconMap.cs" />
    <Compile Include="..\XDM.Core\Util\MimeTypes.cs" Link="Util\MimeTypes.cs" />
    <Compile Include="..\XDM.Core\Util\ChecksumHelper.cs" Link="Util\ChecksumHelper.cs" />
    <Compile Include="..\XDM.Core\Util\ThemePaletteHelper.cs" Link="Util\ThemePaletteHelper.cs" />
    <Compile Include="..\XDM.Core\Translations\TextResource.cs" Link="Translations\TextResource.cs" />
    <Compile Include="..\XDM.Core\BrowserMonitoring\ExtensionData.cs" Link="BrowserMonitoring\ExtensionData.cs" />
    <!-- SingleInstancePolicyTests + NanoServerResilienceTests: arbitration policy and
         the self-contained IPC HTTP server cluster (TraceLog included once, here) -->
    <Compile Include="..\XDM.Core\SingleInstancePolicy.cs" Link="SingleInstancePolicy.cs" />
    <Compile Include="..\XDM.Core\ResumeSelectionPolicy.cs" Link="ResumeSelectionPolicy.cs" />
    <Compile Include="..\XDM.Core\DownloadStatusText.cs" Link="DownloadStatusText.cs" />
    <!-- DownloadListMigrationTests: failure persistence against a real SQLite database -->
    <Compile Include="..\XDM.Core\DataAccess\DownloadList.cs" Link="DataAccess\DownloadList.cs" />
    <Compile Include="..\XDM.Core\DataAccess\SchemaInitializer.cs" Link="DataAccess\SchemaInitializer.cs" />
    <Compile Include="..\XDM.Core\DataAccess\Extensions\DataReaderExtensions.cs" Link="DataAccess\Extensions\DataReaderExtensions.cs" />
    <Compile Include="..\XDM.Core\Downloader\FileNameFetchMode.cs" Link="Downloader\FileNameFetchMode.cs" />
    <!-- DownloadFailureReportingTests: failure reason pipeline (model + mapper + status text) -->
    <Compile Include="..\XDM.Core\ErrorCode.cs" Link="ErrorCode.cs" />
    <Compile Include="..\XDM.Core\DownloadEntries.cs" Link="DownloadEntries.cs" />
    <Compile Include="..\XDM.Core\AuthenticationInfo.cs" Link="AuthenticationInfo.cs" />
    <Compile Include="..\XDM.Core\ProxyInfo.cs" Link="ProxyInfo.cs" />
    <Compile Include="..\XDM.Core\ErrorMessages.cs" Link="ErrorMessages.cs" />
    <Compile Include="..\XDM.Core\Downloader\DownloadFailedEventArgs.cs" Link="Downloader\DownloadFailedEventArgs.cs" />
    <Compile Include="..\XDM.Core\HttpServer\HttpServer.cs" Link="HttpServer\HttpServer.cs" />
    <Compile Include="..\XDM.Core\HttpServer\HttpParser.cs" Link="HttpServer\HttpParser.cs" />
    <Compile Include="..\XDM.Core\HttpServer\RequestContext.cs" Link="HttpServer\RequestContext.cs" />
    <Compile Include="..\XDM.Core\HttpServer\RequestContextEventArgs.cs" Link="HttpServer\RequestContextEventArgs.cs" />
    <Compile Include="..\XDM.Core\HttpServer\ResponseStatus.cs" Link="HttpServer\ResponseStatus.cs" />
    <Compile Include="..\XDM.Core\HttpServer\LineReader.cs" Link="HttpServer\LineReader.cs" />
    <Compile Include="..\XDM.Core\HttpServer\WebSocketSession.cs" Link="HttpServer\WebSocketSession.cs" />
    <Compile Include="..\XDM.Core\TraceLog\Log.cs" Link="TraceLog\Log.cs" />
  </ItemGroup>

</Project>
