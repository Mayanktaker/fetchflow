<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Match XDM.Core's TFM so shared sources compile cleanly -->
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <StartupObject>XDM.Tests.Program</StartupObject>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <!-- MSTest framework (uses [TestClass]/[TestMethod] + Microsoft.VisualStudio.TestTools.UnitTesting) -->
    <PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.1.1" />
    <!-- Newtonsoft.Json required by YDLOutputParser -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <!-- GtkSmokeTests: real Builder/Autoconnect smoke under Xvfb (DISPLAY). Same GtkSharp as XDM.Gtk.UI -->
    <PackageReference Include="GtkSharp" Version="3.24.24.38" />
  </ItemGroup>

  <!-- Surgical include: only the YDLWrapper sources needed by YdlParserTests,
       avoiding the cost/fragility of importing the entire XDM.Core shared project -->
  <ItemGroup>
    <Compile Include="..\XDM.Core\YDLWrapper\YDLOutputParser.cs" Link="YDLWrapper\YDLOutputParser.cs" />
    <Compile Include="..\XDM.Core\YDLWrapper\Structs.cs" Link="YDLWrapper\Structs.cs" />
    <Compile Include="..\XDM.Core\IconResource.cs" Link="IconResource.cs" />
    <Compile Include="..\XDM.Core\RemixIcon.cs" Link="RemixIcon.cs" />
    <Compile Include="..\XDM.Core\UI\IconMap.cs" Link="UI\IconMap.cs" />
    <Compile Include="..\XDM.Core\Util\MimeTypes.cs" Link="Util\MimeTypes.cs" />
    <Compile Include="..\XDM.Core\Util\ChecksumHelper.cs" Link="Util\ChecksumHelper.cs" />
    <Compile Include="..\XDM.Core\Util\ThemePaletteHelper.cs" Link="Util\ThemePaletteHelper.cs" />
    <Compile Include="..\XDM.Core\Translations\TextResource.cs" Link="Translations\TextResource.cs" />
  </ItemGroup>

</Project>
