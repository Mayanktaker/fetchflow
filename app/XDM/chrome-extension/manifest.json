{
    "name": "FetchFlow Browser Helper",
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon16.png",
            "48": "icon48.png",
            "128": "icon128.png"
        }
    },
    "manifest_version": 3,
    "version": "9.1.13",
    "description": "Download files and capture videos with FetchFlow Download Manager",
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+Shift+F",
                "mac": "Alt+Shift+F"
            },
            "description": "Open FetchFlow popup inspector"
        }
    },
    "host_permissions": [
        "*://*/*"
    ],
    "permissions": [
        "downloads",
        "webRequest",
        "webNavigation",
        "tabs",
        "storage",
        "contextMenus",
        "alarms",
        "cookies"
    ],
    "background": {
        "service_worker": "main.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*"],
            "js": ["blob-capture.js"],
            "run_at": "document_start"
        }
    ],
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
}