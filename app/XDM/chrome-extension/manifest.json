{
    "name": "FetchFlow Browser Helper",
    "action": {},
    "manifest_version": 3,
    "version": "9.1.6",
    "description": "Download files and capture videos with FetchFlow Download Manager",
    "host_permissions": [
        "*://*/*"
    ],
    "permissions": [
        "downloads",
        "webRequest",
        "webNavigation",
        "tabs",
        "storage",
        "contextMenus",
        "alarms",
        "cookies"
    ],
    "background": {
        "service_worker": "main.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*"],
            "js": ["blob-capture.js"],
            "run_at": "document_start"
        }
    ],
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
}