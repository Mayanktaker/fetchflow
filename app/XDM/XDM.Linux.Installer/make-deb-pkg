#!/bin/bash
# © Mayanktaker Computers & Web Development | https://mayanktaker.com
# Build a .deb for Debian/Ubuntu (Wayland-aware). Run from XDM.Linux.Installer/.
# Please place all the published files under ./binary-source directory

# Single source of truth for the version
source ./version.env

SRC_DIR=binary-source

rm -rf "fetchflow_${VERSION}_amd64"
rm -f "fetchflow_${VERSION}_amd64.deb"

PKG="fetchflow_${VERSION}_amd64"

mkdir -p "${PKG}/DEBIAN"
mkdir -p "${PKG}/opt/fetchflow"
mkdir -p "${PKG}/usr/bin"
mkdir -p "${PKG}/usr/share/applications"
mkdir -p "${PKG}/usr/share/icons/hicolor/scalable/apps"
mkdir -p "${PKG}/usr/share/mime/packages"

cp -r "${SRC_DIR}/." "${PKG}/opt/fetchflow"
cp ../../../xdm-updater.sh "${PKG}/opt/fetchflow/" 2>/dev/null || :
[ -f "${PKG}/opt/fetchflow/xdm-updater.sh" ] && chmod +x "${PKG}/opt/fetchflow/xdm-updater.sh"

touch "${PKG}/DEBIAN/control"
touch "${PKG}/opt/fetchflow/com.mayanktaker.fetchflow.desktop"
touch "${PKG}/usr/bin/fetchflow"

cat <<EOF > "${PKG}/DEBIAN/control"
Package: fetchflow
Version: ${VERSION}
Architecture: amd64
Depends: libgtk-3-0 (>= 3.24)
Recommends: ffmpeg, libnotify-bin, xdg-desktop-portal
Maintainer: Mayanktaker | Mayanktaker Computers & Web Development (https://mayanktaker.com)
Description: Fast, modern open source download accelerator and video downloader.
 FetchFlow accelerates downloads using multi-connection segments, captures
 streaming videos, and integrates natively with Wayland desktops and modern browsers.
EOF

cat <<EOF > "${PKG}/opt/fetchflow/com.mayanktaker.fetchflow.desktop"
[Desktop Entry]
Version=1.0
Encoding=UTF-8
Exec=env GTK_USE_PORTAL=1 /opt/fetchflow/fetchflow %U
Type=Application
Terminal=false
Name=FetchFlow Download Manager
Comment=Fast, modern download accelerator and video downloader
Categories=Network;FileTransfer;
Icon=fetchflow
MimeType=application/fetchflow;x-scheme-handler/fetchflow;x-scheme-handler/fetchflow+app;x-scheme-handler/xdm-app;x-scheme-handler/xdm+app;
StartupNotify=true
StartupWMClass=com.mayanktaker.fetchflow
EOF

cat <<EOF > "${PKG}/usr/bin/fetchflow"
#!/bin/bash
# Wayland-friendly launcher wrapper
export GTK_USE_PORTAL=1
/opt/fetchflow/fetchflow "\$@"
EOF

# Legacy CLI symlink
cat <<EOF > "${PKG}/usr/bin/xdman"
#!/bin/bash
export GTK_USE_PORTAL=1
/opt/fetchflow/fetchflow "\$@"
EOF

cat <<EOF > "${PKG}/opt/fetchflow/source_pkg.txt"
fetchflow|.deb
EOF

cp "${PKG}/opt/fetchflow/com.mayanktaker.fetchflow.desktop" "${PKG}/usr/share/applications"
cp "${SRC_DIR}/fetchflow-logo.svg" "${PKG}/usr/share/icons/hicolor/scalable/apps/fetchflow.svg" 2>/dev/null || cp "${PKG}/opt/fetchflow/fetchflow-logo.svg" "${PKG}/usr/share/icons/hicolor/scalable/apps/fetchflow.svg"

cat <<EOF > "${PKG}/usr/share/mime/packages/com.mayanktaker.fetchflow.xml"
<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/fetchflow">
    <comment>FetchFlow Download</comment>
    <glob pattern="*.fetchflow"/>
  </mime-type>
</mime-info>
EOF

cat <<EOF > "${PKG}/DEBIAN/postinst"
#!/bin/bash
update-desktop-database -q /usr/share/applications || :
gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || :
update-mime-database -n /usr/share/mime || :
EOF
cat <<EOF > "${PKG}/DEBIAN/postrm"
#!/bin/bash
update-desktop-database -q /usr/share/applications || :
gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || :
update-mime-database -n /usr/share/mime || :
EOF

chmod 755 "${PKG}/usr/bin/fetchflow"
chmod 755 "${PKG}/usr/bin/xdman"
chmod 755 "${PKG}/opt/fetchflow/fetchflow"
chmod 755 "${PKG}/DEBIAN/postinst" "${PKG}/DEBIAN/postrm"

if command -v dpkg-deb >/dev/null 2>&1; then
    dpkg-deb --build --root-owner-group -Z xz "${PKG}"
else
    echo "dpkg-deb not found; assembling .deb package using ar and tar..."
    DEB_OUT="$(pwd)/${PKG}.deb"
    BUILD_TMP="$(mktemp -d)"
    echo "2.0" > "${BUILD_TMP}/debian-binary"
    (cd "${PKG}/DEBIAN" && tar --owner=0 --group=0 --numeric-owner -czf "${BUILD_TMP}/control.tar.gz" *)
    (cd "${PKG}" && tar --owner=0 --group=0 --numeric-owner --exclude="./DEBIAN" -czf "${BUILD_TMP}/data.tar.gz" opt usr)
    (cd "${BUILD_TMP}" && ar -rc "${DEB_OUT}" debian-binary control.tar.gz data.tar.gz)
    rm -rf "${BUILD_TMP}"
    echo "Built: ${DEB_OUT}"
fi
