#!/bin/bash
# © Mayanktaker Computers & Web Development | https://mayanktaker.com
# Build an .rpm for Fedora/RHEL/openSUSE (Wayland-aware). Run from XDM.Linux.Installer/.
# Please place all the published files under ./binary-source directory

# Single source of truth for the version
source ./version.env

SRC_DIR=binary-source
SOURCE_NAME="fetchflow-${VERSION}"

rm -rf "${SOURCE_NAME}"

mkdir -p rpmbuild/{BUILD,BUILDROOT,RPMS,SOURCES,SPECS,SRPMS,tmp}
mkdir "${SOURCE_NAME}"

mkdir -p "${SOURCE_NAME}/opt/fetchflow"
mkdir -p "${SOURCE_NAME}/usr/bin"
mkdir -p "${SOURCE_NAME}/usr/share/applications"
mkdir -p "${SOURCE_NAME}/usr/share/icons/hicolor/scalable/apps"
for sz in 16 22 24 32 48 64 128 256 512; do
    mkdir -p "${SOURCE_NAME}/usr/share/icons/hicolor/${sz}x${sz}/apps"
done
mkdir -p "${SOURCE_NAME}/usr/share/mime/packages"

cp -r "${SRC_DIR}/." "${SOURCE_NAME}/opt/fetchflow"
cp ../../../xdm-updater.sh "${SOURCE_NAME}/opt/fetchflow/" 2>/dev/null || :
[ -f "${SOURCE_NAME}/opt/fetchflow/xdm-updater.sh" ] && chmod +x "${SOURCE_NAME}/opt/fetchflow/xdm-updater.sh"

touch "${SOURCE_NAME}/opt/fetchflow/com.mayanktaker.fetchflow.desktop"
touch "${SOURCE_NAME}/usr/bin/fetchflow"

# Register fetchflow:// and legacy xdm-app:// schemes
cat <<EOF > "${SOURCE_NAME}/opt/fetchflow/com.mayanktaker.fetchflow.desktop"
[Desktop Entry]
Version=1.0
Encoding=UTF-8
Exec=env GTK_USE_PORTAL=1 /opt/fetchflow/fetchflow %U
Type=Application
Terminal=false
Name=FetchFlow Download Manager
Comment=Fast, modern download accelerator and video downloader
Categories=Network;FileTransfer;
Icon=com.mayanktaker.fetchflow
MimeType=application/fetchflow;x-scheme-handler/fetchflow;x-scheme-handler/fetchflow+app;x-scheme-handler/xdm-app;x-scheme-handler/xdm+app;
StartupNotify=true
StartupWMClass=com.mayanktaker.fetchflow
EOF

cat <<EOF > "${SOURCE_NAME}/usr/bin/fetchflow"
#!/bin/bash
# Wayland-friendly launcher wrapper
export GTK_USE_PORTAL=1
/opt/fetchflow/fetchflow "\$@"
EOF

# Legacy CLI symlink
cat <<EOF > "${SOURCE_NAME}/usr/bin/xdman"
#!/bin/bash
export GTK_USE_PORTAL=1
/opt/fetchflow/fetchflow "\$@"
EOF

cat <<EOF > "${SOURCE_NAME}/opt/fetchflow/source_pkg"
fetchflow|.rpm
EOF

cp "${SOURCE_NAME}/opt/fetchflow/com.mayanktaker.fetchflow.desktop" "${SOURCE_NAME}/usr/share/applications"
# Launch-at-login lives in /etc/xdg/autostart (the XDG system location), so it takes effect
# from the first login after install instead of waiting for the app's first run. A per-user
# ~/.config/autostart file of the same name shadows it, which is how Settings turns it off.
# Exec uses --background: the menu entry's %U form would pop the window on every login.
mkdir -p "${SOURCE_NAME}/etc/xdg/autostart"
cat <<EOF > "${SOURCE_NAME}/etc/xdg/autostart/com.mayanktaker.fetchflow.desktop"
[Desktop Entry]
Version=1.0
Type=Application
Terminal=false
TryExec=/opt/fetchflow/fetchflow
Exec=env GTK_USE_PORTAL=1 "/opt/fetchflow/fetchflow" --background
Name=FetchFlow Download Manager
Comment=FetchFlow Download Manager (Wayland Edition)
Categories=Network;
Icon=com.mayanktaker.fetchflow
X-GNOME-Autostart-enabled=true
StartupNotify=false
EOF
chmod 755 "${SOURCE_NAME}/etc/xdg/autostart/com.mayanktaker.fetchflow.desktop"

cp "${SRC_DIR}/fetchflow-logo.svg" "${SOURCE_NAME}/usr/share/icons/hicolor/scalable/apps/fetchflow.svg" 2>/dev/null || cp "${SOURCE_NAME}/opt/fetchflow/fetchflow-logo.svg" "${SOURCE_NAME}/usr/share/icons/hicolor/scalable/apps/fetchflow.svg"
cp "${SOURCE_NAME}/usr/share/icons/hicolor/scalable/apps/fetchflow.svg" "${SOURCE_NAME}/usr/share/icons/hicolor/scalable/apps/com.mayanktaker.fetchflow.svg"
# Light tray glyph for StatusNotifierItem hosts (dark & light panels)
cp "${SRC_DIR}/svg-icons/fetchflow-tray.svg" "${SOURCE_NAME}/usr/share/icons/hicolor/scalable/apps/fetchflow-tray.svg" 2>/dev/null || cp "${SOURCE_NAME}/opt/fetchflow/svg-icons/fetchflow-tray.svg" "${SOURCE_NAME}/usr/share/icons/hicolor/scalable/apps/fetchflow-tray.svg"

for sz in 16 22 24 32 48 64 128 256 512; do
    if [ -f "${SRC_DIR}/fetchflow-logo-${sz}.png" ]; then
        cp "${SRC_DIR}/fetchflow-logo-${sz}.png" "${SOURCE_NAME}/usr/share/icons/hicolor/${sz}x${sz}/apps/fetchflow.png"
        cp "${SRC_DIR}/fetchflow-logo-${sz}.png" "${SOURCE_NAME}/usr/share/icons/hicolor/${sz}x${sz}/apps/com.mayanktaker.fetchflow.png"
    fi
done

cat <<EOF > "${SOURCE_NAME}/usr/share/mime/packages/com.mayanktaker.fetchflow.xml"
<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/fetchflow">
    <comment>FetchFlow Download</comment>
    <glob pattern="*.fetchflow"/>
  </mime-type>
</mime-info>
EOF

chmod 755 "${SOURCE_NAME}/usr/bin/fetchflow"
chmod 755 "${SOURCE_NAME}/usr/bin/xdman"
chmod 755 "${SOURCE_NAME}/opt/fetchflow/fetchflow"

tar --create --file "${SOURCE_NAME}.tar.gz" "${SOURCE_NAME}"
mv "${SOURCE_NAME}.tar.gz" "rpmbuild/SOURCES"

cat <<EOF > "rpmbuild/SPECS/fetchflow.spec"
Name:       	fetchflow
%define debug_package %{nil}
%global __strip /bin/true
%global __brp_strip /bin/true
%global __brp_strip_comment_note /bin/true
%global __brp_strip_lto /bin/true
Version:    	${VERSION}
Release:    	1%{?dist}
Summary:    	FetchFlow Download Manager
AutoReqProv: 	no
Requires:   	gtk3 >= 3.24
Recommends: 	(ffmpeg-free or ffmpeg)
Recommends: 	xdg-desktop-portal
Recommends: 	libnotify
Recommends: 	yt-dlp

Group:      	System Environment/Base
License:    	GPL-2.0-only
Source0:    	${SOURCE_NAME}.tar.gz

%description
Fast, modern, open source download accelerator and video downloader for Linux.

%prep
%setup -q -n fetchflow-%{version}

%install
cp -rfa * %{buildroot}

%post
update-desktop-database -q /usr/share/applications || :
gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || :
update-mime-database -n /usr/share/mime || :

%postun
update-desktop-database -q /usr/share/applications || :
gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || :
update-mime-database -n /usr/share/mime || :

%files
/usr/bin/*
/usr/share/applications/*
/etc/xdg/autostart/*
/usr/share/icons/hicolor/*/*/*
/usr/share/mime/packages/com.mayanktaker.fetchflow.xml
/opt/fetchflow/*
EOF

rpmbuild --define "_topdir `pwd`/rpmbuild" --define "_tmppath `pwd`/rpmbuild/tmp" -bb rpmbuild/SPECS/fetchflow.spec
