<?xml version="1.0" encoding="UTF-8"?>
<!--
  © 2026 Mayanktaker | Based on XDM by subhra74 (https://github.com/subhra74/xdm)
  Freedesktop mime package: registers the application/xdm-app MIME type so
  update-mime-database can resolve .xdm-app descriptors at install time.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/xdm-app">
    <comment>XDM download descriptor</comment>
    <glob pattern="*.xdm-app"/>
  </mime-type>
</mime-info>
