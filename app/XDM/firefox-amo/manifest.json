{
    "name": "XDM v8+ Browser Helper",
    "manifest_version": 3,
    "version": "2.1",
    "description": "Download files with XDM v8+",
    "action": {},
    "host_permissions": [
        "*://*/*"
    ],
    "permissions": [
        "tabs",
        "cookies",
        "menus",
        "activeTab",
        "webRequest",
        "downloads",
        "storage",
        "contextMenus"
    ],
    "background": {
        "service_worker": "main.js"
    },
    "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "xdm-v8-browser-helper@subhra74.github.io",
            "strict_min_version": "128.0"
        }
    }
}
