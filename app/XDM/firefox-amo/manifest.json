{
    "name": "FetchFlow Browser Helper",
    "manifest_version": 3,
    "version": "9.1.5",
    "description": "Download files and capture videos with FetchFlow Download Manager",
    "action": {},
    "host_permissions": [
        "*://*/*"
    ],
    "permissions": [
        "tabs",
        "activeTab",
        "webRequest",
        "webRequestBlocking",
        "webNavigation",
        "downloads",
        "storage",
        "contextMenus",
        "scripting",
        "cookies"
    ],
    "background": {
        "scripts": [
            "app/logger.js",
            "app/connector.js",
            "app/request-watcher.js",
            "app/app.js",
            "main.js"
        ]
    },
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*"],
            "js": ["app/blob-capture.js"],
            "run_at": "document_start"
        }
    ],
    "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "fetchflow-browser-helper@mayanktaker.com",
            "strict_min_version": "128.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}
