{
    "name": "XDM v9 Browser Helper",
    "manifest_version": 3,
    "version": "9.1.0",
    "description": "Download files with XDM v9",
    "action": {},
    "host_permissions": [
        "*://*/*"
    ],
    "permissions": [
        "tabs",
        "menus",
        "activeTab",
        "webRequest",
        "webRequestBlocking",
        "webNavigation",
        "downloads",
        "storage",
        "contextMenus",
        "scripting"
    ],
    "background": {
        "scripts": [
            "app/logger.js",
            "app/connector.js",
            "app/request-watcher.js",
            "app/app.js",
            "main.js"
        ]
    },
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*"],
            "js": ["app/blob-capture.js"],
            "run_at": "document_start"
        }
    ],
    "icons": {
        "16": "icon16.png",
        "32": "icon32.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "xdm-v8-browser-helper@subhra74.github.io",
            "strict_min_version": "128.0"
        }
    }
}
