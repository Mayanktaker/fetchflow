<Window x:Class="XDM.Wpf.UI.Dialogs.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XDM.Wpf.UI.Dialogs.About"
        mc:Ignorable="d"
        Title="{StaticResource MENU_ABOUT}" Height="540" Width="520" ShowInTaskbar="False" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource ControlForecolor}">
    <!-- © Mayanktaker Computers & Web Development | https://mayanktaker.com -->
    <Grid Margin="24,20,24,20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
            <Image Name="AppLogo" Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Name="TxtAppName" FontSize="18" FontWeight="SemiBold" 
                       Foreground="{StaticResource ControlForecolor}" HorizontalAlignment="Center" Margin="0,4,0,4"/>
            <Border Background="{StaticResource ToolbarBordercolor}" CornerRadius="10" Padding="12,3" 
                    HorizontalAlignment="Center" Margin="0,4,0,8">
                <TextBlock Name="TxtAppVersion" FontSize="12" FontWeight="Medium" 
                           Foreground="{StaticResource ControlForecolor}"/>
            </Border>
            <TextBlock Name="TxtTagline" Text="High-performance multi-threaded download manager" 
                       FontSize="12" Foreground="{StaticResource ToolButtonMouseDisabledForecolor}" 
                       HorizontalAlignment="Center" Margin="0,0,0,16"/>

            <Border Background="{StaticResource ListViewBackcolor}" BorderBrush="{StaticResource ControlBordercolor}" 
                    BorderThickness="1" CornerRadius="6" Padding="16,10" Margin="10,0,10,12">
                <StackPanel>
                    <TextBlock Name="BtnAppWebsite" Text="FetchFlow Official Website" Cursor="Hand" 
                               Foreground="{StaticResource HyperlinkForecolor}" Padding="4" HorizontalAlignment="Center" 
                               MouseDown="BtnAppWebsite_MouseDown"/>
                    <TextBlock Name="BtnDevWebsite" Text="Mayanktaker Computers &amp; Web Development" Cursor="Hand" 
                               Foreground="{StaticResource HyperlinkForecolor}" Padding="4" HorizontalAlignment="Center" 
                               MouseDown="BtnDevWebsite_MouseDown"/>
                    <TextBlock Name="BtnGitHub" Text="Source Code &amp; Issue Tracker (GitHub)" Cursor="Hand" 
                               Foreground="{StaticResource HyperlinkForecolor}" Padding="4" HorizontalAlignment="Center" 
                               MouseDown="BtnGitHub_MouseDown"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource ListViewBackcolor}" BorderBrush="{StaticResource ControlBordercolor}" 
                    BorderThickness="1" CornerRadius="6" Padding="16,10" Margin="10,0,10,16">
                <StackPanel>
                    <TextBlock Name="TxtCopyright" FontSize="11" Foreground="{StaticResource ControlForecolor}" 
                               HorizontalAlignment="Center" Margin="0,2"/>
                    <TextBlock Name="TxtOriginalCredit" FontSize="11" Foreground="{StaticResource ToolButtonMouseDisabledForecolor}" 
                               HorizontalAlignment="Center" Margin="0,2"/>
                </StackPanel>
            </Border>

            <Button Name="BtnClose" Content="Close" Padding="28,6" HorizontalAlignment="Center" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
