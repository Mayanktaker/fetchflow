# AUR binary package: repackages the official FetchFlow Arch build from GitHub releases.
# Bump per release: update pkgver + sha256sums, regenerate .SRCINFO (see README.md).
pkgname=fetchflow-bin
pkgver=9.1.15.14
pkgrel=1
pkgdesc="Fast, modern open source download accelerator and video downloader."
arch=('x86_64')
url="https://mayanktaker.com"
license=('GPL2')
depends=('ffmpeg' 'gtk3>=3.24')
optdepends=('xdg-desktop-portal: native file choosers under Wayland/sandboxes'
            'libnotify: desktop notifications'
            'yt-dlp: video/audio extraction from 1000+ sites')
provides=('fetchflow')
conflicts=('fetchflow')
source=("fetchflow-${pkgver}-1-x86_64.pkg.tar.zst::https://github.com/Mayanktaker/fetchflow/releases/download/v${pkgver}/fetchflow-${pkgver}-1-x86_64.pkg.tar.zst")
sha256sums=('af520e81000ade72bf66ae06f52f86101cf28d068870753c99d6fa413c3b0e24') # refresh via updpkgsums after release publish

# Repack official tree (strip pacman metadata)
package() {
    bsdtar -xpf "${srcdir}/fetchflow-${pkgver}-1-x86_64.pkg.tar.zst" -C "${pkgdir}" --exclude=.PKGINFO --exclude=.BUILDINFO --exclude=.MTREE
}
